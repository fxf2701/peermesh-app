{
  "uid": "relay-ops",
  "title": "Relay Ops Overview",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "30s",
  "tags": ["relay", "ops"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(requests_total[5m])",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(errors_total[5m]) / rate(requests_total[5m])",
          "legendFormat": "error_rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB Pool Usage",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "db_pool_in_use",
          "legendFormat": "in_use",
          "refId": "A"
        },
        {
          "expr": "db_pool_total",
          "legendFormat": "total",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Federation Failures",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(federation_sync_fail_total[5m])",
          "legendFormat": "fail/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cleanup Duration",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "cleanup_last_duration_ms",
          "legendFormat": "ms",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate Limit Spikes",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate_limited_spike_active",
          "legendFormat": "spike_active",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "time": { "from": "now-6h", "to": "now" }
}
