PORT=8080
SERVER_MODE=community
DATA_DIR=/app/data

DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/relay
POSTGRES_PASSWORD=CHANGE_ME

RELAY_BIND_IP=127.0.0.1
POSTGRES_BIND_IP=127.0.0.1
PROMETHEUS_BIND_IP=127.0.0.1
GRAFANA_BIND_IP=127.0.0.1
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# Canonical production toggle for relay request signing.
# Legacy REQUEST_SIGNATURE_ENABLED is still accepted by runtime for compatibility,
# but production configs should set REQUEST_SIGNATURE_REQUIRED.
REQUEST_SIGNATURE_REQUIRED=1
ALLOW_UNSIGNED_DEV_REQUESTS=0
REQUEST_SIGNATURE_SECRET=CHANGE_ME
REQUEST_SIGNATURE_SKEW_SECONDS=300
REQUEST_SIGNATURE_REPLAY_TTL_SECONDS=600
REQUEST_SIGNATURE_REPLAY_MAX_ENTRIES=10000

AUDIT_LOG_ENABLED=1
AUDIT_LOG_PATH=./data/audit.log
AUDIT_LOG_SECRET=CHANGE_ME
# Initialize this file on the VPS from config/admin_auth.example.json, then run:
#   ./scripts/reset-admin-password.sh 'change-this-admin-password'
ADMIN_AUTH_FILE=./config/admin_auth.json
ADMIN_SESSION_TTL_SECONDS=28800

TRUSTED_PROXY_IPS=
IP_ALLOWLIST=
IP_DENYLIST=

#
# Registry integration is optional for self-hosted relays.
# Leave these disabled for a standalone relay and enable them only if you
# intentionally register with a PeerMesh registry.
REGISTRY_HEARTBEAT_ENABLED=0
REGISTRY_URL=
REGISTRY_SHARED_SECRET=
REGISTRY_HEARTBEAT_INTERVAL_SECONDS=60

#
# Managed client<->relay sessions depend on a registry-issued access grant flow.
# Standalone relays should keep these disabled.
REGISTRY_CLIENT_ACCESS_GRANTS_ENABLED=0
REGISTRY_CLIENT_ACCESS_GRANT_SIGNING_SECRET=
CLIENT_RELAY_SESSIONS_ENABLED=0
CLIENT_RELAY_SESSION_BINDING_SECRET=
CLIENT_RELAY_SESSION_TTL_SECONDS=300
CLIENT_RELAY_SESSION_CLEANUP_INTERVAL_SECONDS=60
CLIENT_RELAY_SESSION_MAX_PER_CLIENT=4

RELAY_SELF_ID=relay-01
FEDERATION_SELF_ID=relay-01
FEDERATION_SELF_URL=https://relay-01.example.com
FEDERATION_REQUIRE_TLS=1
FEDERATION_PEER_ALLOWLIST=
FEDERATION_PEER_BANLIST=
FEDERATION_PEERS=
FEDERATION_SYNC_GIDS=
FEDERATION_SYNC_INTERVAL_SECONDS=60
FEDERATION_SYNC_MAX_BACKOFF_SECONDS=300
FEDERATION_SYNC_JITTER_SECONDS=5
FEDERATION_SYNC_MAX_IN_FLIGHT_PER_PEER=1
FEDERATION_SYNC_MAX_QUEUE_PER_PEER=2
FEDERATION_SYNC_LIMIT=200
FEDERATION_HEARTBEAT_TTL_SECONDS=30
FEDERATION_HEARTBEAT_FAILURE_THRESHOLD=6000
FEDERATION_HEARTBEAT_BACKOFF_SECONDS=30
FEDERATION_JOIN_RATE_LIMIT=10
FEDERATION_JOIN_RATE_LIMIT_WINDOW_SECONDS=120
FEDERATION_HANDSHAKE_RATE_LIMIT=20
FEDERATION_HANDSHAKE_RATE_LIMIT_WINDOW_SECONDS=120
FEDERATION_HANDSHAKE_INTERVAL_SECONDS=60
FEDERATION_ROTATED_TOKEN_TTL_SECONDS=2592000
FEDERATION_MIN_PEERS=2
FEDERATION_MAX_PEERS=10
FEDERATION_MTLS_ENABLED=0
FEDERATION_MTLS_CERT_PATH=
FEDERATION_MTLS_KEY_PATH=
FEDERATION_MTLS_CA_PATH=
FEDERATION_MTLS_REJECT_UNAUTHORIZED=1
#
# Registry-managed federation sessions are optional. Independent federations
# can keep these disabled and rely on direct peer configuration instead.
REGISTRY_FEDERATION_SESSIONS_ENABLED=0
REGISTRY_FEDERATION_SESSION_SIGNING_SECRET=
REGISTRY_FEDERATION_SESSION_REFRESH_INTERVAL_SECONDS=30
REGISTRY_FEDERATION_SESSION_RETRY_SECONDS=30
REGISTRY_FEDERATION_SESSION_RENEW_AHEAD_SECONDS=60
REGISTRY_FEDERATION_REVOCATIONS_POLL_SECONDS=60
REGISTRY_FEDERATION_SESSION_MAX_PEERS=4
REGISTRY_FEDERATION_SESSION_MAX_EVENTS_PER_MINUTE=600
REGISTRY_FEDERATION_SESSION_MAX_BYTES_PER_MINUTE=10485760

DB_WAIT_MAX_RETRIES=20
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=2000
DB_CIRCUIT_BREAKER_ENABLED=1
DB_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
DB_CIRCUIT_BREAKER_BASE_BACKOFF_MS=500
DB_CIRCUIT_BREAKER_MAX_BACKOFF_MS=5000
DB_COOLDOWN_ENABLED=0
DB_COOLDOWN_WAITING_THRESHOLD=10
DB_COOLDOWN_WAIT_MS_THRESHOLD=50
DB_COOLDOWN_MIN_SECONDS=15
DB_COOLDOWN_STABLE_WINDOWS=2
DB_COOLDOWN_CHECK_INTERVAL_MS=1000
HEALTH_CHECK_DB_TIMEOUT_MS=2000

MAX_EVENTS_PER_REQUEST=100
MAX_EVENT_BYTES=65536
MAX_REQUEST_BYTES=1000000
EVENT_MAX_FUTURE_SECONDS=600
EVENT_EXP_GRACE_SECONDS=300
FETCH_MAX_LIMIT=200
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BURST_WINDOW_SECONDS=10
RATE_LIMIT_SPIKE_WINDOW_SECONDS=60
RATE_LIMIT_SPIKE_THRESHOLD=50
RATE_LIMIT_SPIKE_COOLDOWN_SECONDS=120
INGEST_RATE_LIMIT_PER_IP=120
INGEST_RATE_LIMIT_PER_GID=300
FETCH_RATE_LIMIT_PER_IP=120
FETCH_RATE_LIMIT_PER_GID=300
INGEST_BURST_PER_IP=30
INGEST_BURST_PER_GID=60
FETCH_BURST_PER_IP=30
FETCH_BURST_PER_GID=60
NONCE_CACHE_MAX_ENTRIES=10000
NONCE_CACHE_TTL_SECONDS=600

INGEST_RETRY_ENABLED=0
INGEST_RETRY_MAX_ENTRIES=500
INGEST_RETRY_MAX_ATTEMPTS=5
INGEST_RETRY_BASE_DELAY_MS=500
INGEST_RETRY_MAX_DELAY_MS=5000
INGEST_RETRY_INTERVAL_MS=250

RETENTION_PROFILE=community
CLEANUP_INTERVAL_SECONDS=600
CLEANUP_GRACE_SECONDS=300
CLEANUP_USE_ADVISORY_LOCK=1
CLEANUP_WATCHDOG_TIMEOUT_SECONDS=120
STARTUP_SCHEMA_VALIDATION=1
STARTUP_SCHEMA_VALIDATION_TIMEOUT_MS=5000
PARTITION_AUTO_CREATE_ENABLED=1
PARTITION_AUTO_CREATE_MONTHS_AHEAD=2
PARTITION_AUTO_CREATE_BACKFILL_MONTHS=1
PARTITION_AUTO_CREATE_INTERVAL_SECONDS=3600

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
BACKUP_MAX_AGE_SECONDS=172800
BACKUP_DIR=/backup
# Relay service reads these marker files through the ./backups -> /var/backups/relay bind mount.
BACKUP_OK_FILE=/var/backups/relay/last_backup.ok
RESTORE_DRILL_OK_FILE=/var/backups/relay/last_restore_drill.ok
RESTORE_DRILL_MAX_AGE_SECONDS=1209600
# Relay service reads and appends alert state through the ./logs -> /var/log/relay bind mount.
ALERT_WEBHOOK_URL=
ALERT_LOG_PATH=/var/log/relay/alerts.log
ALERT_TITLE=relay_backup_stale
BANLIST_IMPORT_HMAC_SECRET=CHANGE_ME
