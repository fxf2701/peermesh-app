HOST=0.0.0.0
PORT=8080
REGISTRY_HOST_PORT=8090
REGISTRY_BIND_IP=127.0.0.1

REGISTRY_DB_PATH=/app/data/registry.sqlite
REGISTRY_SHARED_SECRET=change-me
REGISTRY_ACTIVE_TTL_SECONDS=300
REGISTRY_MAX_BODY_BYTES=65536
REGISTRY_SIGNATURE_SKEW_SECONDS=300
REGISTRY_NONCE_TTL_SECONDS=600
REGISTRY_REQUIRE_SIGNATURE=1

# Registry Admin credentials
# Preferred production options:
# 1. REGISTRY_ADMIN_CREDENTIALS_FILE
# 2. REGISTRY_ADMIN_PASSWORD_HASH (+ REGISTRY_ADMIN_USERNAME)
# Plaintext password mode should stay disabled outside dev/test.
# Generate REGISTRY_ADMIN_PASSWORD_HASH with:
#   cd server/registry
#   npm run admin:hash-password -- 'your-strong-password'
# Example hash format:
#   scrypt$16384$8$1$<salt_hex>$<derived_key_hex>
# Example credentials file JSON:
#   {"username":"admin","password_hash":"scrypt$16384$8$1$<salt_hex>$<derived_key_hex>"}
REGISTRY_ADMIN_USERNAME=admin
# Hashed admin password for env-based configuration.
# Leave empty when using REGISTRY_ADMIN_CREDENTIALS_FILE.
REGISTRY_ADMIN_PASSWORD_HASH=
# Absolute path to a JSON credentials file.
# If set, this takes precedence over REGISTRY_ADMIN_USERNAME and REGISTRY_ADMIN_PASSWORD_HASH.
REGISTRY_ADMIN_CREDENTIALS_FILE=/run/peermesh-secrets/registry-admin-credentials.json
# Admin session lifetime in seconds.
# 28800 = 8 hours, 14400 = 4 hours, 3600 = 1 hour.
REGISTRY_ADMIN_SESSION_TTL_SECONDS=28800
# Keep 0 in production. Set to 1 only for short-lived dev/test plaintext mode.
REGISTRY_ADMIN_ALLOW_PLAINTEXT_PASSWORD=0
# Plaintext admin password. Only used when REGISTRY_ADMIN_ALLOW_PLAINTEXT_PASSWORD=1.
# Keep empty in production.
REGISTRY_ADMIN_PASSWORD=

# Managed federation
REGISTRY_FEDERATION_SESSION_SIGNING_SECRET=change-me-session-signing-secret
REGISTRY_FEDERATION_SESSION_TTL_SECONDS=300
REGISTRY_FEDERATION_MAX_PEERS_PER_SESSION=4
REGISTRY_FEDERATION_POLICY_VERSION=1
REGISTRY_FEDERATION_MIN_TRUST_LEVEL=trusted
REGISTRY_FEDERATION_REQUIRE_CERTIFICATE=0
REGISTRY_FEDERATION_MAX_EVENTS_PER_MINUTE=600
REGISTRY_FEDERATION_MAX_BYTES_PER_MINUTE=10485760
REGISTRY_FEDERATION_MAX_IN_FLIGHT=4

# Managed client access
REGISTRY_CLIENT_ACCESS_GRANT_TTL_SECONDS=300
REGISTRY_CLIENT_ACCESS_MAX_CANDIDATES=3
REGISTRY_CLIENT_ACCESS_POLICY_VERSION=1
REGISTRY_CLIENT_ACCESS_MIN_TRUST_LEVEL=trusted
REGISTRY_CLIENT_ACCESS_GRANT_SIGNING_SECRET=change-me-client-grant-signing-secret
REGISTRY_CLIENT_ACCESS_MAX_EVENTS_PER_MINUTE=120
REGISTRY_CLIENT_ACCESS_MAX_BYTES_PER_MINUTE=1048576
REGISTRY_CLIENT_ACCESS_PREFER_SAME_REGION=1

# Client abuse reports
REGISTRY_CLIENT_ABUSE_REPORT_ACCEPTANCE_WINDOW_SECONDS=900
REGISTRY_CLIENT_ABUSE_DEPRIORITIZE_WINDOW_SECONDS=3600
REGISTRY_CLIENT_ABUSE_PAIR_COOLDOWN_SECONDS=1800
REGISTRY_CLIENT_ABUSE_SINGLE_REPORT_WEIGHT=1
REGISTRY_CLIENT_ABUSE_DISTINCT_CLIENT_BONUS=2
REGISTRY_CLIENT_ABUSE_DUPLICATE_BUCKET_SECONDS=300
REGISTRY_CLIENT_ABUSE_RATE_LIMIT_WINDOW_SECONDS=900
REGISTRY_CLIENT_ABUSE_MAX_REPORTS_PER_CLIENT_WINDOW=8
REGISTRY_CLIENT_ABUSE_MAX_REPORTS_PER_IP_WINDOW=16
REGISTRY_CLIENT_ABUSE_MAX_REPORTS_PER_GRANT_WINDOW=4
REGISTRY_CLIENT_ABUSE_CORROBORATION_CLIENT_THRESHOLD=2
REGISTRY_CLIENT_ABUSE_CORROBORATION_SCORE_THRESHOLD=3
