<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_app_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/group_chat_connection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/peerMeshNoticeSurface"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/group_chat_connection_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/group_chat_connection_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?android:textColorSecondary"
                android:text="@string/group_chat_connectivity_online_and_nearby_body"
                android:visibility="gone" />

            <Button
                android:id="@+id/group_chat_connection_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/group_chat_connectivity_action_check_again"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/messages_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_messages_empty"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/ble_permission_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/chat_ble_permission_required"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone" />

        <Button
            android:id="@+id/ble_permission_grant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ble_permission_grant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ble_permission_settings_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ble_permission_settings_hint"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone" />

        <Button
            android:id="@+id/ble_permission_open_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ble_permission_open_settings"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/reply_compose_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_reply_compose"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/reply_compose_actor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:text="@string/chat_replying_to_placeholder" />

                <TextView
                    android:id="@+id/reply_compose_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/chat_message_body_placeholder"
                    android:textColor="?android:textColorSecondary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/reply_compose_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_reply_cancel"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/message_input_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/message_input"
                style="@style/PeerMeshPlaceholderText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/chat_message_hint"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:textColor="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/message_send"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_send"
                android:src="@drawable/ic_send"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <TextView
            android:id="@+id/message_send_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            android:text="@string/chat_send_failed" />

        <TextView
            android:id="@+id/message_char_counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:text="@string/message_char_counter_placeholder"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
</LinearLayout>
