<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/marker_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/marker_visibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/map_toggle_show"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <TextView
        android:id="@+id/marker_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/marker_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/marker_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/marker_contrib_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/marker_removal_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorOnSurface"
        android:textColorLink="?attr/colorSecondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/marker_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorOnSurface"
        android:textColorLink="?attr/colorSecondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/marker_details"
        style="@style/PeerMeshButtonSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/map_detail_open" />

    <LinearLayout
        android:id="@+id/marker_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/marker_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/PeerMeshButtonSecondary"
            android:text="@string/edit" />

        <Button
            android:id="@+id/marker_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            style="@style/PeerMeshButtonSecondary"
            android:text="@string/delete" />
    </LinearLayout>
</LinearLayout>
