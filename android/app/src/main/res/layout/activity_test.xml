<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/include_app_header" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <CheckBox
                android:id="@+id/dev_mode_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorOnBackground"
                android:text="@string/dev_mode_title" />

            <LinearLayout
                android:id="@+id/pro_entitlement_debug_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pro_entitlement_debug_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pro_entitlement_debug_title"
                    android:textColor="?attr/colorOnBackground"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pro_entitlement_debug_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/pro_entitlement_debug_status"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/pro_entitlement_debug_free"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pro_entitlement_debug_free" />

                    <Button
                        android:id="@+id/pro_entitlement_debug_trial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/pro_entitlement_debug_trial" />

                    <Button
                        android:id="@+id/pro_entitlement_debug_pro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/pro_entitlement_debug_pro" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/pro_entitlement_debug_expired"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pro_entitlement_debug_expired" />

                    <Button
                        android:id="@+id/pro_entitlement_debug_unknown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/pro_entitlement_debug_unknown" />

                    <Button
                        android:id="@+id/pro_entitlement_debug_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/pro_entitlement_debug_clear" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/pro_entitlement_debug_sync_beta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pro_entitlement_debug_sync_beta" />
                </LinearLayout>
            </LinearLayout>


            <TextView
                android:id="@+id/status_scan_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/status_scan_filter"
                android:textColor="?attr/colorOnSurface" />

            <CheckBox
                android:id="@+id/ble_scan_no_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ble_scan_no_filter"
                android:textColor="?attr/colorOnBackground" />

            <CheckBox
                android:id="@+id/ble_advertise_single_chunk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ble_advertise_single_chunk"
                android:textColor="?attr/colorOnBackground" />

            <Button
                android:id="@+id/ble_restart_mesh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ble_restart_mesh" />

            <Button
                android:id="@+id/ble_corrupt_next_chunk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ble_corrupt_next_chunk" />

            <TextView
                android:id="@+id/seed_relays_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/seed_relays_title"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/seed_relays_input"
                style="@style/PeerMeshPlaceholderText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/seed_relays_hint"
                android:inputType="textMultiLine"
                android:textColor="?attr/colorOnSurface"
                android:minLines="3" />

            <Button
                android:id="@+id/seed_relays_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/seed_relays_save" />

            <TextView
                android:id="@+id/seed_relays_select_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/seed_relays_select_title"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/seed_relays_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/seed_relays_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/seed_relays_apply" />

            <Button
                android:id="@+id/relay_test_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/relay_test_now" />

            <Button
                android:id="@+id/relay_debug_seed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/relay_debug_seed" />

            <Button
                android:id="@+id/relay_clear_db"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/relay_clear_db" />

            <Button
                android:id="@+id/crash_test_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/crash_test_now" />

            <TextView
                android:id="@+id/test_alt_users_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/test_alt_users_title"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/test_alt_users_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp" />

            <Button
                android:id="@+id/test_alt_users_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/test_alt_users_add" />

            <LinearLayout
                android:id="@+id/test_alt_users_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/activity_log_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/activity_log_title"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/activity_log_prefix"
                style="@style/PeerMeshPlaceholderText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_background"
                android:hint="@string/activity_log_prefix_hint"
                android:inputType="text"
                android:padding="10dp"
                android:textColor="?attr/colorOnSurface" />

            <EditText
                android:id="@+id/activity_log_duration"
                style="@style/PeerMeshPlaceholderText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_background"
                android:hint="@string/activity_log_duration_hint"
                android:inputType="text"
                android:padding="10dp"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/activity_log_label_groups_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/activity_log_label_groups_title"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/activity_log_label_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <EditText
                android:id="@+id/activity_log_patterns"
                style="@style/PeerMeshPlaceholderText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_background"
                android:hint="@string/activity_log_patterns_hint"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top|start"
                android:padding="10dp"
                android:textColor="?attr/colorOnSurface" />

            <EditText
                android:id="@+id/activity_log_allowed_labels"
                style="@style/PeerMeshPlaceholderText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_background"
                android:hint="@string/activity_log_allowed_labels_hint"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top|start"
                android:padding="10dp"
                android:textColor="?attr/colorOnSurface" />

            <Button
                android:id="@+id/activity_log_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/activity_log_start" />

            <CheckBox
                android:id="@+id/activity_log_start_after_reboot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/activity_log_start_after_reboot" />

            <LinearLayout
                android:id="@+id/activity_log_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/help_title" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/drawer_menu"
        app:itemTextAppearance="@style/PeerMeshDrawerItemText"
        app:itemHorizontalPadding="20dp"
        app:itemVerticalPadding="12dp"
        app:itemIconPadding="0dp"
        app:itemBackground="@drawable/drawer_item_background"
        app:divider="?attr/peerMeshMenuDivider"
        app:subheaderTextAppearance="@style/PeerMeshDrawerItemText"
        app:itemTextColor="?attr/colorOnSurface"
        app:itemIconTint="?attr/colorOnSurface" />
</androidx.drawerlayout.widget.DrawerLayout>
