<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_app_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/group_detail_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_detail_title"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/group_removed_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/detail_value_background"
                android:padding="12dp"
                android:text="@string/group_removed_detail_read_only"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone" />

            <TextView
                android:id="@+id/group_invite_rotation_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/detail_value_background"
                android:padding="12dp"
                android:text="@string/group_invite_rotation_notice"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone" />

            <TextView
                android:id="@+id/group_gid_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/group_gid_label"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/detail_value_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/group_gid_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:typeface="monospace"
                    android:text="-"
                    android:textColor="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/group_gid_show"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/show"
                    android:src="@drawable/ic_eye"
                    app:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/group_gid_copy"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/copy"
                    android:src="@drawable/ic_copy"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <TextView
                android:id="@+id/group_passphrase_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/group_passphrase_label"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/detail_value_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/group_passphrase_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:typeface="monospace"
                    android:text="-"
                    android:textColor="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/group_passphrase_show"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/show"
                    android:src="@drawable/ic_eye"
                    app:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/group_passphrase_copy"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/copy"
                    android:src="@drawable/ic_copy"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <TextView
                android:id="@+id/group_name_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/group_name_label"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/detail_value_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/group_name_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/group_name_edit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/edit"
                    android:src="@drawable/ic_edit"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/group_name_edit_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/group_name_edit_input"
                    style="@style/PeerMeshPlaceholderText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/group_name_hint"
                    android:inputType="textCapWords"
                    android:textColor="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/group_name_save"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/save"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/group_name_cancel"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:src="@drawable/ic_close"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/user_display_name_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/group_display_name_label"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/detail_value_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/user_display_name_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/user_display_name_edit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/edit"
                    android:src="@drawable/ic_edit"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/user_display_name_edit_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/user_display_name_edit_input"
                    style="@style/PeerMeshPlaceholderText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/group_display_name_edit_hint"
                    android:inputType="textPersonName"
                    android:textColor="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/user_display_name_save"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/save"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/user_display_name_cancel"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:src="@drawable/ic_close"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/user_avatar_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/user_avatar_label"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/user_avatar_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/avatar_cat"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/avatar_option_background"
                    android:contentDescription="@string/avatar_cat"
                    android:gravity="center"
                    android:text=""
                    android:textSize="20sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/avatar_dog"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/avatar_option_background"
                    android:contentDescription="@string/avatar_dog"
                    android:gravity="center"
                    android:text="▾"
                    android:textSize="20sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/avatar_fox"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/avatar_option_background"
                    android:contentDescription="@string/avatar_fox"
                    android:gravity="center"
                    android:text=""
                    android:textSize="20sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/avatar_bear"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/avatar_option_background"
                    android:contentDescription="@string/avatar_bear"
                    android:gravity="center"
                    android:text=""
                    android:textSize="20sp"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <Button
                android:id="@+id/group_open_settings"
                style="@style/PeerMeshButtonSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/group_open_settings" />

            <Button
                android:id="@+id/group_send_invite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/group_send_invite" />

            <Button
                android:id="@+id/group_show_qr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/PeerMeshButtonSecondary"
                android:text="@string/group_show_qr" />

            <Button
                android:id="@+id/group_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/PeerMeshButtonSecondary"
                android:text="@string/close" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
