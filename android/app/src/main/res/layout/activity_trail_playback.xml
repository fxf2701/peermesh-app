<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_app_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/trail_playback_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/trail_playback_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_margin="12dp"
            android:background="?attr/colorSurface"
            android:padding="6dp"
            android:text="@string/trail_playback_clock_default"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/trail_playback_attribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/colorSurface"
            android:padding="4dp"
            android:text="@string/map_attribution_osm"
            android:textColor="?attr/colorOnSurface"
            android:textSize="10sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="vertical"
        android:background="?attr/colorSurface">

        <TextView
            android:id="@+id/trail_playback_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trail_playback_time_default"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/trail_playback_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/trail_playback_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/PeerMeshButtonSecondary"
                android:text="@string/trail_playback_play" />

            <Button
                android:id="@+id/trail_playback_jump"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                style="@style/PeerMeshButtonSecondary"
                android:text="@string/trail_playback_jump" />

            <Button
                android:id="@+id/trail_playback_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                style="@style/PeerMeshButtonSecondary"
                android:text="@string/trail_playback_close" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
