<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_app_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/beta_program_info_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/beta_program_info_intro"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/beta_program_info_season"
                style="@style/PeerMeshHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/beta_program_info_ends_at"
                style="@style/PeerMeshHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/beta_program_info_what_you_get_title"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <TextView
                style="@style/PeerMeshHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/beta_program_info_what_you_get_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/beta_program_info_feedback_title"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <TextView
                style="@style/PeerMeshHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/beta_program_info_feedback_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/beta_program_info_privacy_title"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <TextView
                style="@style/PeerMeshHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/beta_program_info_privacy_body" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
