<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_app_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/map_activity_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_map_status_text"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/map_activity_banner_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/map_activity_banner_content_description"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Map container with floating layers -->
        <FrameLayout
            android:id="@+id/map_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="14">

            <org.osmdroid.views.MapView
                android:id="@+id/group_map_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/map_zoom_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:layout_marginBottom="76dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical"
                android:elevation="6dp"
                android:translationZ="6dp">

                <ImageButton
                    android:id="@+id/map_zoom_in"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_floating_button"
                    android:contentDescription="@string/zoom_in"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_zoom_in"
                    app:tint="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/map_zoom_out"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_floating_button"
                    android:contentDescription="@string/zoom_out"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_zoom_out"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/map_center_user"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|bottom"
                android:layout_marginBottom="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_floating_button"
                android:contentDescription="@string/map_center_user"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_my_pos"
                app:tint="?attr/colorOnSurface"
                android:elevation="6dp"
                android:translationZ="6dp" />

            <!-- Floating status (top) -->
            <TextView
                android:id="@+id/map_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="0dp"
                android:alpha="0.9"
                android:padding="10dp"
                android:background="@drawable/bg_map_status_text"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/map_attribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/colorSurface"
                android:padding="4dp"
                android:text="@string/map_attribution_osm"
                android:textColor="?attr/colorOnSurface"
                android:textSize="10sp" />

            <!-- Floating action bar (bottom) -->
            <LinearLayout
                android:id="@+id/map_action_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/map_cancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/PeerMeshButtonSecondary"
                    android:text="@string/map_cancel" />

                <Button
                    android:id="@+id/map_done"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/map_done" />
            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/map_collapse_handle"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/map_collapse">

            <View
                android:layout_width="64dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_collapse_handle" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/map_items_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="6" />

    </LinearLayout>
</LinearLayout>
