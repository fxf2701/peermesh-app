<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/trail_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/trail_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorOnSurface" />

    <Switch
        android:id="@+id/trail_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/map_toggle_show"
        android:textColor="?attr/colorOnSurface" />

    <Button
        android:id="@+id/trail_show_on_map"
        style="@style/PeerMeshButtonSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/shared_trails_show_on_map" />

    <Button
        android:id="@+id/trail_replay"
        style="@style/PeerMeshButtonSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/trail_replay_replay" />

    <Button
        android:id="@+id/trail_delete_archived"
        style="@style/PeerMeshButtonSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/map_live_trail_delete"
        android:visibility="gone" />
</LinearLayout>
