<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_app_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/pro_unlock_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pro_unlock_title"
                android:textColor="?attr/colorOnBackground"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pro_unlock_offer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_warning_banner"
                android:padding="14dp"
                android:text="@string/pro_unlock_offer"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pro_unlock_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pro_unlock_body"
                android:textColor="?attr/colorOnBackground"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/pro_unlock_features"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pro_unlock_features"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/pro_unlock_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pro_unlock_status_free"
                android:textColor="?android:attr/textColorSecondary" />

            <Button
                android:id="@+id/pro_unlock_cta"
                style="@style/PeerMeshButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/pro_unlock_cta" />

            <Button
                android:id="@+id/pro_unlock_restore"
                style="@style/PeerMeshButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/pro_unlock_restore" />

            <Button
                android:id="@+id/pro_unlock_close"
                style="@style/PeerMeshButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/not_now" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
