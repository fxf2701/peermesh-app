<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/include_app_header" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/nearby_rooms_setup_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_chat_message"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/nearby_rooms_setup_status_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/active_dot" />

                        <TextView
                            android:id="@+id/nearby_rooms_setup_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/nearby_rooms_setup_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/nearby_rooms_setup_checklist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/nearby_rooms_setup_grant_permission"
                            style="@style/PeerMeshButtonSecondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nearby_setup_grant_permission"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/nearby_rooms_setup_enable_bluetooth"
                            style="@style/PeerMeshButtonSecondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/nearby_setup_enable_bluetooth"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/nearby_rooms_setup_enable_location"
                            style="@style/PeerMeshButtonSecondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/nearby_setup_turn_on_location"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nearby_rooms_intro_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nearby_rooms_intro_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nearby_rooms_intro_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/nearby_rooms_intro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/nearby_rooms_intro"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/nearby_rooms_create_helper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/nearby_rooms_create_helper"
                        android:textColor="?android:attr/textColorSecondary" />

                    <Button
                        android:id="@+id/nearby_rooms_create"
                        style="@style/PeerMeshButtonSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/nearby_rooms_create" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nearby_rooms_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_chat_message"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/nearby_rooms_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/nearby_rooms_empty_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/nearby_rooms_empty_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/nearby_rooms_empty_body"
                        android:textAlignment="center"
                        android:textColor="?android:attr/textColorSecondary" />

                    <Button
                        android:id="@+id/nearby_rooms_empty_create"
                        style="@style/PeerMeshButtonSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/nearby_rooms_empty_create" />

                    <TextView
                        android:id="@+id/nearby_rooms_empty_tip"
                        style="@style/PeerMeshHintText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/nearby_rooms_empty_tip"
                        android:textAlignment="center" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/nearby_rooms_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/nearby_identity_onboarding"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurface"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/nearby_identity_onboarding_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nearby_identity_onboarding_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/nearby_identity_onboarding_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/nearby_identity_onboarding_subtitle"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/nearby_identity_onboarding_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/nearby_identity_onboarding_body"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/nearby_identity_onboarding_privacy"
                        style="@style/PeerMeshHintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/nearby_identity_onboarding_privacy" />

                    <TextView
                        android:id="@+id/nearby_identity_display_name_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/profile_display_name_label"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/nearby_identity_display_name_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/input_background"
                        android:hint="@string/profile_display_name_hint"
                        android:inputType="textPersonName"
                        android:padding="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/nearby_identity_display_name_error"
                        style="@style/PeerMeshHintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/status_error"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/nearby_identity_avatar_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/user_avatar_label"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/nearby_identity_avatar_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/detail_value_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/nearby_identity_avatar_preview_container"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/avatar_circle">

                            <TextView
                                android:id="@+id/nearby_identity_avatar_preview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textColor="@android:color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/nearby_identity_avatar_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:textColor="?attr/colorOnSurface" />

                        <Button
                            android:id="@+id/nearby_identity_avatar_button"
                            style="@style/PeerMeshButtonSecondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_choose_avatar" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/nearby_identity_avatar_error"
                        style="@style/PeerMeshHintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/status_error"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/nearby_identity_onboarding_footer"
                        style="@style/PeerMeshHintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/nearby_identity_onboarding_footer" />

                    <Button
                        android:id="@+id/nearby_identity_continue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:enabled="false"
                        android:text="@string/nearby_identity_continue" />
                </LinearLayout>
            </ScrollView>

            <app.peermesh.NearbyRoomsLoadingDotsView
                android:id="@+id/nearby_rooms_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:fitsSystemWindows="true"
        app:divider="?attr/peerMeshMenuDivider"
        app:headerLayout="@layout/drawer_header"
        app:itemBackground="@drawable/drawer_item_background"
        app:itemHorizontalPadding="20dp"
        app:itemIconPadding="0dp"
        app:itemIconTint="?attr/colorOnSurface"
        app:itemTextAppearance="@style/PeerMeshDrawerItemText"
        app:itemTextColor="?attr/colorOnSurface"
        app:itemVerticalPadding="12dp"
        app:menu="@menu/drawer_menu"
        app:subheaderTextAppearance="@style/PeerMeshDrawerItemText" />
</androidx.drawerlayout.widget.DrawerLayout>
