<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/filterAllButton"
                style="@style/PeerMeshButtonSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shared_trails_filter_all" />

            <Button
                android:id="@+id/filterLiveButton"
                style="@style/PeerMeshButtonSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/shared_trails_filter_live" />

            <Button
                android:id="@+id/filterArchivedButton"
                style="@style/PeerMeshButtonSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/shared_trails_filter_archived" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/sharedTrailsEmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/shared_trails_empty_all" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sharedTrailsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>